<mxPoint x="1215" y="380"/></Array></mxGeometry></mxCell><mxCell id="e18" value="otomatik onay" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0.25;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="G1" target="T8"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1475" y="530"/></Array></mxGeometry></mxCell><mxCell id="e19" value="evet" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0.75;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="G3" target="T8"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1545" y="680"/></Array></mxGeometry></mxCell><mxCell id="e20" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="T8" target="T9"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1680" y="110"/></Array></mxGeometry></mxCell><mxCell id="e21" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="T9" target="G4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e22" value="evet" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="G4" target="Eok"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e23" value="hayır" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="G4" target="RT"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e24" value="yeniden dene" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="RT" target="T9"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1935" y="445"/><mxPoint x="1680" y="445"/></Array></mxGeometry></mxCell><mxCell id="leg" value="&lt;b&gt;As-Is'e göre değişenler&lt;/b&gt; (FR kodları BRD'deki gereksinimlerdir)&lt;br&gt;D1 → bilgiler önceden dolduruluyor · D2 → gelir bilgisi rızayla dijital alınıyor, belge sadece istisna · D3 → SLA'lı iş kuyruğu ve durum bildirimi · D4 → eksik belge uygulama içinden isteniyor · D5 → aktarım hatasında otomatik yeniden deneme, müşteriye durum ve ekibe bildirim · D6 → red nedeni kategorisi ve tekrar başvuru süresi gösteriliyor · Ön onaylı limit karar motoruyla eşleştiriliyor (FR-13)&lt;br&gt;&lt;i&gt;Başvuru ekranına erişim sorunu (7 şikayet) teknik bir hata olduğu için süreçte ayrı adım olarak çizilmedi; BRD'de fonksiyonel olmayan gereksinim olarak ele alınmalı.&lt;/i&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=12;" vertex="1" parent="1"><mxGeometry x="20" y="780" width="1700" height="90" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>