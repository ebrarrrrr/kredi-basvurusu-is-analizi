 döngüsü&lt;br&gt;&lt;i&gt;Bu bir taslaktır. 2. haftadaki yorum ve şikayet analizine göre adımları, darboğazları ve süreleri güncelle.&lt;/i&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=12;" vertex="1" parent="1"><mxGeometry x="20" y="700" width="1400" height="70" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="p3" name="3 - As-Is (araştırma sonrası)"><mxGraphModel dx="1400" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1600" pageHeight="900" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="t" value="As-Is: Mobil ihtiyaç kredisi başvurusu – araştırma bulgularıyla (Kasım 2026)" style="text;html=1;align=left;verticalAlign=middle;fontSize=18;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="20" y="0" width="1400" height="40" as="geometry"/></mxCell><mxCell id="pool" value="Örnek Banka" style="swimlane;html=1;horizontal=0;startSize=30;fillColor=#e8eef7;swimlaneFillColor=#ffffff;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="20" y="40" width="2120" height="720" as="geometry"/></mxCell><mxCell id="L1" value="Müşteri" style="swimlane;html=1;horizontal=0;startSize=30;fillColor=#f5f5f5;swimlaneFillColor=#ffffff;" vertex="1" parent="pool"><mxGeometry x="30" y="0" width="2090" height="260" as="geometry"/></mxCell><mxCell id="L2" value="Mobil uygulama" style="swimlane;html=1;horizontal=0;startSize=30;fillColor=#f5f5f5;swimlaneFillColor=#ffffff;" vertex="1" parent="pool"><mxGeometry x="30" y="260" width="2090" height="160" as="geometry"/></mxCell><mxCell id="L3" value="Karar motoru" style="swimlane;html=1;horizontal=0;startSize=30;fillColor=#f5f5f5;swimlaneFillColor=#ffffff;" vertex="1" parent="pool"><mxGeometry x="30" y="420" width="2090" height="140" as="geometry"/></mxCell><mxCell id="L4" value="Kredi tahsis" style="swimlane;html=1;horizontal=0;startSize=30;fillColor=#f5f5f5;swimlaneFillColor=#ffffff;" vertex="1