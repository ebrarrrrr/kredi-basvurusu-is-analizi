<mxfile host="app.diagrams.net"><diagram id="p0" name="0 - BPMN Sembolleri"><mxGraphModel dx="1400" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1600" pageHeight="900" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="t" value="BPMN'de bilmen gereken 6 temel sembol" style="text;html=1;align=left;verticalAlign=middle;fontSize=18;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="600" height="40" as="geometry"/></mxCell><mxCell id="s1" value="Başlangıç olayı" style="shape=mxgraph.bpmn.event;html=1;verticalLabelPosition=bottom;verticalAlign=top;align=center;perimeter=ellipsePerimeter;outlineConnect=0;aspect=fixed;outline=standard;symbol=general;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="80" y="110" width="40" height="40" as="geometry"/></mxCell><mxCell id="s2" value="Bitiş olayı" style="shape=mxgraph.bpmn.event;html=1;verticalLabelPosition=bottom;verticalAlign=top;align=center;perimeter=ellipsePerimeter;outlineConnect=0;aspect=fixed;outline=end;symbol=general;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="280" y="110" width="40" height="40" as="geometry"/></mxCell><mxCell id="s3" value="Formu doldur" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="430" y="100" width="120" height="60" as="geometry"/></mxCell><mxCell id="s4" value="Belge tam mı?" style="shape=mxgraph.bpmn.gateway2;html=1;verticalLabelPosition=top;verticalAlign=bottom;align=center;perimeter=rhombusPerimeter;outlineConnect=0;outline=none;symbol=none;gwType=exclusive;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="660" y="105" width="50" height="50" as="geometry"/></mxCell><mxCell id="a1" value="" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="820" y="110" width="1" height="1" as="geometry"/></mxCell><mxCell id="a2" value="" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="920" y="110" width="1" height="1" as="geometry"/></mxCell><mxCell id="e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="a1" target="a2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="d1" value="&lt;b&gt;Başlangıç olayı&lt;/b&gt;&lt;br&gt;İnce çizgili daire. Süreci tetikleyen şey: &quot;Müşteri kredi almak ister&quot;." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="190" width="170" height="90" as="geometry"/></mxCell><mxCell id="d2" value="&lt;b&gt;Bitiş olayı&lt;/b&gt;&lt;br&gt;Kalın çizgili daire. Sürecin sonucu: &quot;Kredi hesaba geçti&quot;. Bir süreçte birden fazla olabilir." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=12;" vertex="1" parent="1"><mxGeometry x="230" y="190" width="170" height="90" as="geometry"/></mxCell><mxCell id="d3" value="&lt;b&gt;Görev&lt;/b&gt;&lt;br&gt;Yuvarlak köşeli dikdörtgen. Yapılan iş, fiille yazılır: &quot;Formu doldur&quot;, &quot;Form doldurma&quot; değil." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=12;" vertex="1" parent="1"><mxGeometry x="420" y="190" width="170" height="90" as="geometry"/></mxCell><mxCell id="d4" value="&lt;b&gt;Karar kapısı (XOR)&lt;/b&gt;&lt;br&gt;İçinde X olan elmas. Çıkan yollardan yalnızca biri seçilir. Her çıkış okuna etiket yaz." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=12;" vertex="1" parent="1"><mxGeometry x="610" y="190" width="170" height="90" as="geometry"/></mxCell><mxCell id="d5" value="&lt;b&gt;Sıra akışı&lt;/b&gt;&lt;br&gt;Düz ok. Adımların hangi sırayla yapıldığını gösterir." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=12;" vertex="1" parent="1"><mxGeometry x="800" y="190" width="170" height="90" as="geometry"/></mxCell><mxCell id="pool" value="Havuz (organizasyon)" style="swimlane;html=1;horizontal=0;startSize=30;fillColor=#e8eef7;swimlaneFillColor=#ffffff;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="320" width="700" height="200" as="geometry"/></mxCell><mxCell id="l1" value="Şerit: Müşteri" style="swimlane;html=1;horizontal=0;startSize=30;fillColor=#f5f5f5;swimlaneFillColor=#ffffff;" vertex="1" parent="pool"><mxGeometry x="30" y="0" width="670" height="100" as="geometry"/></mxCell><mxCell id="l2" value="Şerit: Banka" style="swimlane;html=1;horizontal=0;startSize=30;fillColor=#f5f5f5;swimlaneFillColor=#ffffff;" vertex="1" parent="pool"><mxGeometry x="30" y="100" width="670" height="100" as="geometry"/></mxCell><mxCell id="d6" value="&lt;b&gt;Havuz ve şeritler&lt;/b&gt;&lt;br&gt;Havuz bir organizasyonu, şeritler içindeki rolleri gösterir. Bir görev hangi şeritteyse o işi o rol yapar. Ok bir şeritten diğerine geçiyorsa iş el değiştiriyor demektir; darboğazlar çoğu zaman bu noktalarda olur." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=12;" vertex="1" parent="1"><mxGeometry x="770" y="330" width="320" height="160" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="p1" name="1 - Isınma: Kahve siparişi"><mxGraphModel dx="1400" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1600" pageHeight="900" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="t" value="Isınma alıştırması: Kafede kahve siparişi" style="text;html=1;align=left;verticalAlign=middle;fontSize=18;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="20" y="0" width="700" height="40" as="geometry"/></mxCell><mxCell id="pool" value="Kafe" style="swimlane;html=1;horizontal=0;startSize=30;fillColor=#e8eef7;swimlaneFillColor=#ffffff;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="20" y="50" width="1000" height="380" as="geometry"/></mxCell><mxCell id="lm" value="Müşteri" style="swimlane;html=1;horizontal=0;startSize=30;fillColor=#f5f5f5;swimlaneFillColor=#ffffff;" vertex="1" parent="pool"><mxGeometry x="30" y="0" width="970" height="160" as="geometry"/></mxCell><mxCell id="lb" value="Barista" style="swimlane;html=1;horizontal=0;startSize=30;fillColor=#f5f5f5;swimlaneFillColor=#ffffff;" vertex="1" parent="pool"><mxGeometry x="30" y="160" width="970" height="220" as="geometry"/></mxCell><mxCell id="st" value="Kahve ister" style="shape=mxgraph.bpmn.event;html=1;verticalLabelPosition=bottom;verticalAlign=top;align=center;perimeter=ellipsePerimeter;outlineConnect=0;aspect=fixed;outline=standard;symbol=general;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="110" y="110" width="40" height="40" as="geometry"/></mxCell><mxCell id="t1" value="Sipariş ver ve öde" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="190" y="100" width="120" height="60" as="geometry"/></mxCell><mxCell id="t2" value="Siparişi al" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="340" y="260" width="120" height="60" as="geometry"/></mxCell><mxCell id="g1" value="Ürün var mı?" style="shape=mxgraph.bpmn.gateway2;html=1;verticalLabelPosition=top;verticalAlign=bottom;align=center;perimeter=rhombusPerimeter;outlineConnect=0;outline=none;symbol=none;gwType=exclusive;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="510" y="265" width="50" height="50" as="geometry"/></mxCell><mxCell id="t3" value="Kahveyi hazırla" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="610" y="260" width="120" height="60" as="geometry"/></mxCell><mxCell id="t4" value="Kahveyi teslim et" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#